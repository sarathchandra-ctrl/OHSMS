# Build-time settings for the app (Vite). Copy to .env for local development.
# Nothing here is secret: every VITE_ value ends up in the public bundle.
#
# In a deployment these are normally left empty: the organization's server
# answers /runtime-config.js with the data gateway and sign-in method, and the
# Cloudflare Worker forwards that file to it (docs/CLOUDFLARE.md).

# Local development against `npm run server` on this machine.
VITE_DATA_DRIVER=postgres
VITE_DATA_GATEWAY=http://localhost:8080
# oidc | saml | supabase — normally supplied by the server after /setup.
VITE_AUTH_METHOD=

# Optional error reporting (Sentry DSN). Empty means off.
VITE_SENTRY_DSN=

# Field encryption for sensitive records. Turn on only with DATA_KEY_MASTER set
# on the server and backed up: losing it destroys the sealed records.
VITE_ENCRYPTION=off

# Inactivity sign-out.
VITE_SESSION_IDLE_MINUTES=
VITE_SESSION_WARN_SECONDS=

# Optional app-store links shown on the sign-in page.
VITE_APP_STORE_URL=
VITE_TESTFLIGHT_URL=
