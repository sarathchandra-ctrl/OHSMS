# Response headers for the Cloudflare deploy (wrangler.jsonc).
#
# Cloudflare merges every matching block, joining duplicate header names, so
# the narrower blocks below detach the catch-all Cache-Control with
# "! Cache-Control" before setting their own.
#
# The Content-Security-Policy names only hosts the app contacts today:
#   img-src     OpenStreetMap tiles (maps); Firebase Storage, read-only, for
#               photos attached before files moved to this server
#   connect-src geocoding and nearby-services lookups (Nominatim, Overpass
#               mirrors, Google Places) and Sentry error reports
# The Firebase sign-in, Firestore, Cloud Functions and reCAPTCHA hosts it
# used to list are gone with those services: each one was somewhere an
# injected script could send data or load code from.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=()
  Strict-Transport-Security: max-age=86400
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://firebasestorage.googleapis.com https://*.firebasestorage.app; connect-src 'self' https://nominatim.openstreetmap.org https://overpass-api.de https://lz4.overpass-api.de https://overpass.kumi.systems https://overpass.private.coffee https://overpass.openstreetmap.fr https://maps.mail.ru https://places.googleapis.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src 'none'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

# Vite's content-hashed bundles. Only these are immutable: an unhashed file
# such as runtime-config.js cached for a year would pin a stale config.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/health.json
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json

/store.json
  Content-Type: application/json; charset=utf-8
