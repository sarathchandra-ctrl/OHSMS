// Cloudflare Workers deploy of one organization's OHSMS. docs/CLOUDFLARE.md.
//
// The Worker (worker/index.js) serves the built app from Cloudflare's edge and
// runs the organization's server itself (worker/server.js): the database in
// Cloudflare D1, uploaded files in R2. Set ORIGIN_URL instead to forward the
// server paths to a server of your own through a Cloudflare Tunnel.
//
// This file exists so `wrangler deploy` does not run its framework
// auto-configuration, which tried to rewrite vite.config.js and failed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohsms",
  "main": "worker/index.js",
  // Builds the app into dist/ before every deploy, including Cloudflare's own
  // build from GitHub (Workers Builds), which otherwise deploys without it.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-06-01",
  // node:crypto and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These reach the Worker even though dist/ may hold a file of the same
    // name (public/runtime-config.js is a placeholder).
    "run_worker_first": [
      "/data",
      "/auth/*",
      "/presign",
      "/blob",
      "/rpc/*",
      "/health",
      "/runtime-config.js"
    ]
  },
  // The schema is bundled as text; there is no file system on Workers.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // The database: Cloudflare D1 (SQLite), Asia-Pacific. Access rules are
  // enforced by stack/policy.mjs; the tables are created on first request.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ohsms",
      "database_id": "3aff9e27-04ec-4d51-b4d6-7c8bbf46830a"
    }
  ],
  // Create this private bucket once before deploying: wrangler r2 bucket create ohsms-files.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ohsms-files" }],
  "vars": {
    // The address people type. Every sign-in redirect and file link is built on it.
    "PUBLIC_ORIGIN": "https://ohsms.sarath-chandra.workers.dev",
    // The organization created on first start.
    "ORG_NAME": "Cult Fit",
    // The first administrator's ADMIN_PASSWORD was chosen by the operator, so
    // it is not forced to change at first sign-in. "true" for a generated one.
    "ADMIN_MUST_CHANGE": "false",
    // Sender of password-reset emails, on a domain verified in Resend, e.g.
    // "Cult Fit SMS <noreply@curefit.com>". With RESEND_API_KEY (secret) set,
    // the sign-in page offers "Forgot password?"; empty keeps resets with admins.
    "MAIL_FROM": "",
    // Leave empty to run the server here. Set to a Tunnel hostname
    // (https://ehs-origin.example.com) to use a server of your own instead.
    "ORIGIN_URL": ""
  },
  // Secrets, set with `npx wrangler secret put NAME` (never in this file):
  //   SESSION_SECRET, DATA_KEY_MASTER, RESEND_API_KEY (password-reset mail),
  //   and for the first start ADMIN_EMAIL and ADMIN_PASSWORD (the first
  //   administrator, who must change it at sign-in)
  "observability": { "enabled": true }
}
