// Cloudflare Workers deploy of one organization's OHSMS.
//
// The Worker (worker/index.js) serves the built app from Cloudflare's edge and
// forwards the server's paths to the organization's own server through a
// Cloudflare Tunnel. docs/CLOUDFLARE.md is the procedure.
//
// This file exists so `wrangler deploy` does not run its framework
// auto-configuration. Without it, wrangler tries to parse and rewrite
// vite.config.js to add its own plugin, and the deploy failed with
// "Error parsing file: vite.config.js".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "ohsms",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every unknown path serves index.html. /privacy and /terms resolve to
    // their .html files through the default html_handling.
    "not_found_handling": "single-page-application",
    // These reach the Worker even though dist/ has a file of the same name
    // (public/runtime-config.js is a build-time placeholder): the server's
    // version is the one that knows the connected sign-in.
    "run_worker_first": [
      "/data",
      "/auth/*",
      "/presign",
      "/blob",
      "/rpc/*",
      "/oidc/*",
      "/.well-known/*",
      "/setup",
      "/scim/*",
      "/health",
      "/runtime-config.js"
    ]
  },
  "vars": {
    // The Tunnel hostname of the organization's server, e.g.
    // "https://ehs-origin.example.com". Empty until the server is connected:
    // the Worker then answers its paths with 503 "not configured".
    "ORIGIN_URL": ""
  },
  "observability": { "enabled": true }
}
