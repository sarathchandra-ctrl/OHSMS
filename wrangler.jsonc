// Cloudflare Workers deploy of one organization's OHSMS. docs/CLOUDFLARE.md.
//
// The Worker (worker/index.js) serves the built app from Cloudflare's edge and
// runs the organization's server itself (worker/server.js): the database in
// Cloudflare D1, uploaded files in R2.
//
// This file exists so `wrangler deploy` does not run its framework
// auto-configuration, which tried to rewrite vite.config.js and failed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohsms",
  "main": "worker/index.js",
  // Builds the app into dist/ before every deploy, including Cloudflare's own
  // build from GitHub (Workers Builds), which otherwise deploys without it.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-06-01",
  // node:crypto and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  // The server's own jobs (stack/schedule.mjs): LOTO due/overdue flags every
  // five minutes; the Recycle Bin purge, the closed-permit purge and stale
  // public permit pages nightly at 03:45 IST. Change these together with
  // FREQUENT_CRON / NIGHTLY_CRON there, which pick the job by the expression.
  "triggers": { "crons": ["*/5 * * * *", "15 22 * * *", "30 2 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These reach the Worker even though dist/ may hold a file of the same
    // name (public/runtime-config.js is a placeholder).
    "run_worker_first": [
      "/data",
      "/auth/*",
      "/presign",
      "/blob",
      "/rpc/*",
      "/health",
      "/runtime-config.js",
      // So a script from a previous build gets a 404 rather than index.html
      // (worker/index.js, missingAsset).
      "/assets/*"
    ]
  },
  // The schema is bundled as text; there is no file system on Workers.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // The database: Cloudflare D1 (SQLite), Asia-Pacific. Access rules are
  // enforced by stack/policy.mjs; the tables are created on first request.
  // The id is not a credential (it is useless without an API token for the
  // account) and stays here on purpose: without it Wrangler provisions a
  // database by name, and a new empty one would bootstrap a blank
  // organization in front of the real records.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ohsms",
      "database_id": "3aff9e27-04ec-4d51-b4d6-7c8bbf46830a"
    }
  ],
  // Create this private bucket once before deploying: wrangler r2 bucket create ohsms-files.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ohsms-files" }],
  // PUBLIC_ORIGIN, the address people type, is deliberately not in this file:
  // the repository is public, and the live hostname is operational detail
  // that stays with the operator (AGENTS.md). It is set on the Worker itself
  // (dashboard, or `--var PUBLIC_ORIGIN:https://…` on the first deploy), and
  // keep_vars stops every later deploy from deleting it. Every sign-in
  // redirect and file link is built on it; without it the server answers 503
  // naming PUBLIC_ORIGIN (worker/server.js settingsProblems).
  "keep_vars": true,
  "vars": {
    // The organization created on first start.
    "ORG_NAME": "Cult Fit",
    // The first administrator's ADMIN_PASSWORD was chosen by the operator, so
    // it is not forced to change at first sign-in. "true" for a generated one.
    "ADMIN_MUST_CHANGE": "false",
    // Sender of password-reset emails, on a domain verified in Resend, e.g.
    // "OHSMS <noreply@example.com>". With RESEND_API_KEY (secret) set,
    // the sign-in page offers "Forgot password?"; empty keeps resets with admins.
    "MAIL_FROM": ""
  },
  // Secrets, set with `npx wrangler secret put NAME` (never in this file):
  //   SESSION_SECRET, DATA_KEY_MASTER, RESEND_API_KEY (password-reset mail),
  //   and for the first start ADMIN_EMAIL and ADMIN_PASSWORD (the first
  //   administrator, who must change it at sign-in)
  "observability": { "enabled": true }
}
