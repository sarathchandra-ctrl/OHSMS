{
  "name": "ohsms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OHS Management System \u2014 single-organization Occupational Health & Safety platform (incidents, HIRA, inspections, audits, permit-to-work, LOTO, fire marshal, HSE committee, training, documents/SDS), self-hosted on the organization's own server and Postgres database.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "server": "node stack/main.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@sentry/browser": "^10.69.0",
    "@xyflow/react": "^12.0.4",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.19",
    "html-to-image": "^1.11.11",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.417.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-router-dom": "^7.18.4",
    "react-to-print": "^2.15.1",
    "recharts": "^2.12.7",
    "three": "^0.185.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
