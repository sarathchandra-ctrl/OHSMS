{
  "name": "ohsms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OHS Management System — single-organization Occupational Health & Safety platform (incidents, HIRA, inspections, audits, permit-to-work, LOTO, fire marshal, HSE committee, training, documents/SDS), on Cloudflare Workers with D1 and R2.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile:sync": "npm run build && npx cap sync ios",
    "mobile:ios": "npx cap open ios",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@react-leaflet/core": "^2.1.0",
    "@sentry/browser": "^10.78.0",
    "@xyflow/react": "^12.12.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.19",
    "html-to-image": "^1.11.11",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.5",
    "react-to-print": "^2.15.1",
    "recharts": "^2.12.7",
    "three": "^0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "undici": "^6.28.0",
    "node-gyp": {
      "undici": "^8.12.3"
    },
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
