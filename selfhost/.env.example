# Settings for selfhost/compose.yaml. Copy to .env (next to compose.yaml) and
# fill in every value. .env holds secrets: keep it off shared drives and out
# of version control, and back it up somewhere safe.
#
# Generate each random value with the command shown. Hex keeps the database
# passwords safe to put in a connection URL.

# The server image to run, pinned. Build it with
#   docker build -f stack/Dockerfile -t ohsms-server .
# or take it from the release page (prefer the @sha256 digest form).
WEEHS_IMAGE=ghcr.io/OWNER/ohsms-server:3.0.0

# The front door: `caddy` (HTTPS on this server, ports 80 and 443 open) or
# `cloudflare` (Cloudflare Tunnel, no inbound ports; docs/CLOUDFLARE.md).
COMPOSE_PROFILES=caddy

# The name people type, with no https:// — for example ehs.example.com.
# With caddy its DNS record must point at this server before the first start.
# With cloudflare it is the Worker's hostname (not the tunnel's).
DOMAIN=

# cloudflare profile only: the token of the tunnel, from Zero Trust →
# Networks → Tunnels → your tunnel → Install connector.
TUNNEL_TOKEN=

# Database passwords. openssl rand -hex 24
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# First start only: the organization and its first administrator, who must
# choose a new password at first sign-in. At least 10 characters.
ORG_NAME=Cult Fit
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs sign-in sessions. Changing it signs everyone out. openssl rand -hex 32
SESSION_SECRET=

# Wraps the keys for encrypted fields. 32 bytes, base64 (hex is refused).
# openssl rand -base64 32
DATA_KEY_MASTER=

# Optional: outgoing mail (incident notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

